generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum McatSection {
  CP
  CARS
  BB
  PS
}

enum StudyTaskStatus {
  todo
  in_progress
  done
}

enum MistakeType {
  content_gap
  reasoning_error
  timing_issue
  careless_error
}

enum TutorMode {
  teach
  hint
  socratic
  review
  drill
  cars_coach
  plan
}

enum SessionKind {
  diagnostic
  question
  passage
  full_length
}

enum SessionStatus {
  created
  in_progress
  submitted
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String
  fullName           String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  profile            UserProfile?
  sessions           Session[]
  studyPlans         StudyPlan[]
  questionAttempts   QuestionAttempt[]
  passageAttempts    PassageAttempt[]
  fullLengthAttempts FullLengthAttempt[]
  practiceSessions   PracticeSession[]
  practiceAnswers    PracticeAnswer[]
  reviewItems        ReviewItem[]
  errorLogEntries    ErrorLogEntry[]
  spacedItems        SpacedRepetitionItem[]
  topicMasteries     TopicMastery[]
  scorePredictions   ScorePrediction[]
  aiConversations    AiConversation[]
}

model UserProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  targetScore       Int?
  testDate          DateTime?
  diagnosticScore   Int?
  strongestSection  McatSection?
  weakestSection    McatSection?
  weeklyStudyHours  Int?
  studyPhase        String?
  timezone          String?     @default("America/Los_Angeles")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id             String      @id @default(cuid())
  userId         String
  weekStartDate  DateTime
  generatedAt    DateTime    @default(now())
  tasks          StudyTask[]
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStartDate])
}

model StudyTask {
  id               String          @id @default(cuid())
  studyPlanId      String
  title            String
  section          McatSection
  topic            String
  dueDate          DateTime
  durationMinutes  Int
  priority         Int
  status           StudyTaskStatus @default(todo)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  studyPlan        StudyPlan       @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([dueDate, status])
}

model Topic {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  section       McatSection
  summary       String
  highYield     Boolean  @default(false)
  contentMd     String
  blueprintCategory String?
  reasoningSkill String?
  timingBurden  Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  questions     Question[]
  passages      Passage[]
  masteries     TopicMastery[]
  sessionItems  PracticeSessionItem[]
}

model Question {
  id               String         @id @default(cuid())
  topicId          String
  stem             String
  difficulty       Int
  explanation      String
  wrongRationale   String
  mistakeRule      String
  createdAt        DateTime       @default(now())
  topic            Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answerChoices    AnswerChoice[]
  attempts         QuestionAttempt[]
  sessionItems     PracticeSessionItem[]
}

model Passage {
  id               String          @id @default(cuid())
  topicId          String
  title            String
  body             String
  section          McatSection
  questions        PassageQuestion[]
  attempts         PassageAttempt[]
  topic            Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model PassageQuestion {
  id              String         @id @default(cuid())
  passageId       String
  prompt          String
  explanation     String
  indexInPassage  Int
  answerChoices   AnswerChoice[]
  passage         Passage        @relation(fields: [passageId], references: [id], onDelete: Cascade)
  sessionItems    PracticeSessionItem[]
}

model AnswerChoice {
  id               String   @id @default(cuid())
  questionId       String?
  passageQuestionId String?
  label            String
  text             String
  isCorrect        Boolean
  question         Question?       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  passageQuestion  PassageQuestion? @relation(fields: [passageQuestionId], references: [id], onDelete: Cascade)
}

model QuestionAttempt {
  id               String      @id @default(cuid())
  userId           String
  questionId       String
  selectedChoiceId String
  isCorrect        Boolean
  confidence       Int
  elapsedSeconds   Int
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model PassageAttempt {
  id               String      @id @default(cuid())
  userId           String
  passageId        String
  scorePercent     Int
  elapsedSeconds   Int
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage          Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)
}

model FullLengthAttempt {
  id              String      @id @default(cuid())
  userId          String
  date            DateTime
  cpScore         Int
  carsScore       Int
  bbScore         Int
  psScore         Int
  totalScore      Int
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReviewItem {
  id                 String      @id @default(cuid())
  userId             String
  questionAttemptId  String?
  passageAttemptId   String?
  summary            String
  keyTakeaway        String
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ErrorLogEntry {
  id              String       @id @default(cuid())
  userId          String
  section         McatSection
  topic           String
  mistakeType     MistakeType
  note            String
  status          String       @default("unresolved")
  tags            String[]
  recurrenceCount Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpacedRepetitionItem {
  id             String      @id @default(cuid())
  userId         String
  prompt         String
  answer         String
  topic          String
  section        McatSection
  ease           Float       @default(2.5)
  intervalDays   Int         @default(1)
  dueDate        DateTime
  reviewCount    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

model TopicMastery {
  id             String      @id @default(cuid())
  userId         String
  topicId        String
  mastery        Int
  confidence     Int
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model ScorePrediction {
  id            String      @id @default(cuid())
  userId        String
  low           Int
  high          Int
  confidence    Int
  generatedAt   DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PracticeSession {
  id                  String          @id @default(cuid())
  userId              String
  kind                SessionKind
  section             McatSection?
  timed               Boolean         @default(true)
  status              SessionStatus   @default(created)
  startedAt           DateTime        @default(now())
  submittedAt         DateTime?
  totalItems          Int
  totalCorrect        Int             @default(0)
  totalElapsedSeconds Int             @default(0)
  scorePercent        Int?
  contextNote         String?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               PracticeSessionItem[]
  answers             PracticeAnswer[]

  @@index([userId, kind, startedAt])
}

model PracticeSessionItem {
  id               String         @id @default(cuid())
  sessionId        String
  orderIndex       Int
  section          McatSection
  topicId          String?
  questionId       String?
  passageQuestionId String?
  blueprintCategory String?
  reasoningSkill   String?
  session          PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic            Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  question         Question?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
  passageQuestion  PassageQuestion? @relation(fields: [passageQuestionId], references: [id], onDelete: SetNull)
  answers          PracticeAnswer[]

  @@index([sessionId, orderIndex])
}

model PracticeAnswer {
  id               String      @id @default(cuid())
  sessionId        String
  userId           String
  sessionItemId    String
  section          McatSection
  questionId       String?
  passageQuestionId String?
  selectedChoiceId String
  isCorrect        Boolean
  confidence       Int
  elapsedSeconds   Int
  mistakeType      MistakeType?
  missClass        String?
  blueprintCategory String?
  reasoningSkill   String?
  createdAt        DateTime    @default(now())
  session          PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             PracticeSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@index([userId, createdAt])
}

model AiConversation {
  id            String      @id @default(cuid())
  userId        String
  title         String
  mode          TutorMode
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  messages      AiMessage[]
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id              String          @id @default(cuid())
  conversationId  String
  role            String
  content         String
  contextType     String?
  contextId       String?
  createdAt       DateTime        @default(now())
  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
